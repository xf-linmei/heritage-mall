<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.heritage.dao.CollectDao">

    <!-- 收藏结果映射：同样通过 association 嵌套查询带出商品信息 -->
    <resultMap id="collectMap" type="com.heritage.entity.Collect">
        <id property="collectId" column="collect_id"/>
        <result property="userId" column="user_id"/>
        <result property="productId" column="product_id"/>
        <result property="createTime" column="create_time"/>
        <association property="product" column="product_id"
                     select="com.heritage.dao.ProductDao.selectById"/>
    </resultMap>

    <select id="selectByUser" resultMap="collectMap">
        SELECT * FROM collect WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>

    <!-- 判断是否已收藏（避免重复收藏） -->
    <select id="selectByUserAndProduct" resultMap="collectMap">
        SELECT * FROM collect WHERE user_id = #{userId} AND product_id = #{productId}
    </select>

    <insert id="insert" parameterType="com.heritage.entity.Collect"
            useGeneratedKeys="true" keyProperty="collectId">
        INSERT INTO collect (user_id, product_id) VALUES (#{userId}, #{productId})
    </insert>

    <delete id="delete">
        DELETE FROM collect WHERE collect_id = #{collectId}
    </delete>

    <delete id="deleteByUserAndProduct">
        DELETE FROM collect WHERE user_id = #{userId} AND product_id = #{productId}
    </delete>

    <select id="countByUser" resultType="int">
        SELECT COUNT(1) FROM collect WHERE user_id = #{userId}
    </select>

</mapper>
