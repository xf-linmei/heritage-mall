<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.heritage.dao.BannerDao">

    <resultMap id="bannerMap" type="com.heritage.entity.Banner">
        <id property="bannerId" column="banner_id"/>
        <result property="title" column="title"/>
        <result property="imageUrl" column="image_url"/>
        <result property="linkUrl" column="link_url"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 后台：全部轮播，按排序值升序 -->
    <select id="selectAll" resultMap="bannerMap">
        SELECT * FROM banner ORDER BY sort_order ASC, banner_id DESC
    </select>

    <!-- 前台首页：只展示启用的轮播 -->
    <select id="selectEnabled" resultMap="bannerMap">
        SELECT * FROM banner WHERE status = 1 ORDER BY sort_order ASC, banner_id DESC
    </select>

    <select id="selectById" resultMap="bannerMap">
        SELECT * FROM banner WHERE banner_id = #{bannerId}
    </select>

    <insert id="insert" parameterType="com.heritage.entity.Banner"
            useGeneratedKeys="true" keyProperty="bannerId">
        INSERT INTO banner (title, image_url, link_url, sort_order, status)
        VALUES (#{title}, #{imageUrl}, #{linkUrl}, #{sortOrder}, #{status})
    </insert>

    <update id="update">
        UPDATE banner
        SET title      = #{title},
            image_url  = #{imageUrl},
            link_url   = #{linkUrl},
            sort_order = #{sortOrder}
        WHERE banner_id = #{bannerId}
    </update>

    <delete id="delete">
        DELETE FROM banner WHERE banner_id = #{bannerId}
    </delete>

    <!-- 启用 / 禁用 -->
    <update id="updateStatus">
        UPDATE banner SET status = #{status} WHERE banner_id = #{bannerId}
    </update>

</mapper>
