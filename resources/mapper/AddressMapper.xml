<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.heritage.dao.AddressDao">

    <resultMap id="addressMap" type="com.heritage.entity.Address">
        <id property="addressId" column="address_id"/>
        <result property="userId" column="user_id"/>
        <result property="receiver" column="receiver"/>
        <result property="phone" column="phone"/>
        <result property="addressDetail" column="address_detail"/>
        <result property="isDefault" column="is_default"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 默认地址排在最前面（is_default DESC），其余按 ID 倒序 -->
    <select id="selectByUser" resultMap="addressMap">
        SELECT * FROM address
        WHERE user_id = #{userId}
        ORDER BY is_default DESC, address_id DESC
    </select>

    <select id="selectById" resultMap="addressMap">
        SELECT * FROM address WHERE address_id = #{addressId}
    </select>

    <insert id="insert" parameterType="com.heritage.entity.Address"
            useGeneratedKeys="true" keyProperty="addressId">
        INSERT INTO address (user_id, receiver, phone, address_detail, is_default)
        VALUES (#{userId}, #{receiver}, #{phone}, #{addressDetail}, #{isDefault})
    </insert>

    <update id="update">
        UPDATE address
        SET receiver       = #{receiver},
            phone          = #{phone},
            address_detail = #{addressDetail}
        WHERE address_id = #{addressId}
    </update>

    <delete id="delete">
        DELETE FROM address WHERE address_id = #{addressId}
    </delete>

    <!-- 先把该用户所有地址取消默认，再设置新的默认地址（两步保证只有一个默认） -->
    <update id="clearDefault">
        UPDATE address SET is_default = 0 WHERE user_id = #{userId}
    </update>

    <update id="setDefault">
        UPDATE address SET is_default = 1 WHERE address_id = #{addressId} AND user_id = #{userId}
    </update>

</mapper>
